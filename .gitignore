# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MLS agent full reports — contain commission structure, vendor names and
# REALTOR-only remarks. Source data for listings.ts; never publish them.
/listings pdfs/

# Claude Code tooling (bundled skills, local launch config) — not part of the site
/.claude/

# Source photography (94MB of originals). Optimised copies live in
# public/listings/ and ARE committed; these masters stay local.
/listing photos/
